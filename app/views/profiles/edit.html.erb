<div class="mobile-container">
  <div class="page-header">
    <h1>Editar Perfil</h1>
    <%= link_to "Cancelar", profile_path, class: "btn btn-outline btn-sm" %>
  </div>

  <div class="mobile-card">
    <%= form_with(model: @user, url: profile_path, method: :patch, local: true) do |form| %>
      <% if @user.errors.any? %>
        <div class="error-messages">
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= form.label :name, "Nome" %>
        <%= form.text_field :name, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= form.label :monthly_income, "Renda Mensal" %>
        <%= form.number_field :monthly_income, step: "0.01", class: "form-control" %>
      </div>

      <div class="form-group">
        <%= form.label :currency, "Moeda" %>
        <%= form.select :currency, [['Real (BRL)', 'BRL'], ['Dolar (USD)', 'USD'], ['Euro (EUR)', 'EUR']], { include_blank: "Selecione" }, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= form.label :timezone, "Fuso Horario" %>
        <%= form.time_zone_select :timezone, nil, { include_blank: "Selecione" }, class: "form-control" %>
      </div>

      <%= form.submit "Salvar", class: "btn btn-primary", data: { turbo_submits_with: "Salvando..." } %>
    <% end %>
  </div>
</div>
