<div class="mobile-container">
  <header class="dashboard-header">
    <h1>Olá, <%= current_user.name %>!</h1>
    <p class="date"><%= Date.current.strftime("%A, %d de %B") %></p>
  </header>

  <div class="balance-summary">
    <div class="balance-card income">
      <h3>Receitas</h3>
      <p class="amount">R$ <%= number_with_precision(@total_income, precision: 2) %></p>
    </div>
    <div class="balance-card expense">
      <h3>Despesas</h3>
      <p class="amount">R$ <%= number_with_precision(@total_expenses, precision: 2) %></p>
    </div>
    <div class="balance-card total">
      <h3>Saldo</h3>
      <p class="amount <%= @balance >= 0 ? 'positive' : 'negative' %>">
        R$ <%= number_with_precision(@balance, precision: 2) %>
      </p>
    </div>
  </div>

  <div class="quick-actions">
    <%= link_to new_financial_entry_path(entry_type: 'income'), class: "action-btn" do %>
      <span class="icon">➕</span>
      Nova Receita
    <% end %>
    
    <%= link_to new_financial_entry_path(entry_type: 'expense'), class: "action-btn" do %>
      <span class="icon">➖</span>
      Nova Despesa
    <% end %>
    
    <%= link_to financial_entries_path, class: "action-btn" do %>
      <span class="icon">📋</span>
      Todas
    <% end %>
  </div>

  <div class="recent-transactions mobile-card">
    <div class="section-header">
      <h2>Transações Recentes</h2>
      <%= link_to "Ver todas", financial_entries_path, class: "see-all" %>
    </div>
    
    <% if @recent_transactions.any? %>
      <div class="transactions-list">
        <% @recent_transactions.each do |transaction| %>
          <div class="transaction-item">
            <div class="transaction-info">
              <div class="transaction-icon <%= transaction.entry_type %>">
                <%= transaction.entry_type == 'income' ? '📥' : '📤' %>
              </div>
              <div class="transaction-details">
                <h4><%= transaction.description %></h4>
                <p class="transaction-meta">
                  <%= transaction.date.strftime("%d/%m") %> • 
                  <%= transaction.category&.name || "Sem categoria" %>
                </p>
              </div>
            </div>
            <div class="transaction-amount <%= transaction.entry_type %>">
              <%= transaction.entry_type == 'income' ? '+' : '-' %>
              R$ <%= number_with_precision(transaction.amount, precision: 2) %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="empty-state">Nenhuma transação cadastrada ainda.</p>
      <%= link_to "Criar primeira transação", new_financial_entry_path, class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

<nav class="bottom-nav">
  <%= link_to dashboard_path, class: "nav-item #{'active' if current_page?(dashboard_path)}" do %>
    <span class="nav-icon">🏠</span>
    Início
  <% end %>
  
  <%= link_to financial_entries_path, class: "nav-item #{'active' if current_page?(financial_entries_path)}" do %>
    <span class="nav-icon">💰</span>
    Transações
  <% end %>
  
  <%= link_to new_financial_entry_path, class: "nav-item special" do %>
    <span class="nav-icon">➕</span>
    Nova
  <% end %>
  
  <a href="#" class="nav-item">
    <span class="nav-icon">📊</span>
    Relatórios
  </a>
  
  <%= link_to edit_user_registration_path, class: "nav-item" do %>
    <span class="nav-icon">⚙️</span>
    Conta
  <% end %>
</nav>

<style>
  .dashboard-header {
    padding: 20px 16px;
    background: white;
    border-bottom: 1px solid #e0e0e0;
  }
  
  .dashboard-header h1 {
    margin: 0;
    font-size: 1.5rem;
  }
  
  .date {
    color: #666;
    margin: 5px 0 0 0;
  }
  
  .balance-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    padding: 16px;
  }
  
  .balance-card {
    padding: 16px;
    border-radius: 12px;
    text-align: center;
  }
  
  .balance-card h3 {
    margin: 0 0 8px 0;
    font-size: 0.9rem;
    color: #666;
  }
  
  .balance-card.income { background: #d4edda; }
  .balance-card.expense { background: #f8d7da; }
  .balance-card.total { background: #cce5ff; }
  
  .amount {
    font-size: 1.2rem;
    font-weight: bold;
    margin: 0;
  }
  
  .amount.positive { color: #28a745; }
  .amount.negative { color: #dc3545; }
  
  .quick-actions {
    display: flex;
    justify-content: space-around;
    padding: 0 16px 16px;
  }
  
  .action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px;
    background: white;
    border-radius: 12px;
    text-decoration: none;
    color: #333;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    min-width: 80px;
  }
  
  .action-btn .icon {
    font-size: 1.5rem;
    margin-bottom: 8px;
  }
  
  .recent-transactions {
    margin: 0 16px;
  }
  
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  
  .section-header h2 {
    margin: 0;
    font-size: 1.3rem;
  }
  
  .see-all {
    color: #4a6fa5;
    text-decoration: none;
    font-size: 0.9rem;
  }
  
  .transaction-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid #eee;
  }
  
  .transaction-item:last-child {
    border-bottom: none;
  }
  
  .transaction-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  
  .transaction-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
  }
  
  .transaction-icon.income { background: #d4edda; }
  .transaction-icon.expense { background: #f8d7da; }
  
  .transaction-details h4 {
    margin: 0 0 4px 0;
    font-size: 1rem;
  }
  
  .transaction-meta {
    margin: 0;
    font-size: 0.8rem;
    color: #666;
  }
  
  .transaction-amount {
    font-weight: bold;
  }
  
  .transaction-amount.income { color: #28a745; }
  .transaction-amount.expense { color: #dc3545; }
  
  .empty-state {
    text-align: center;
    color: #666;
    padding: 40px 0;
  }
  
  .bottom-nav .nav-item.special {
    background: #4a6fa5;
    color: white;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    margin-top: -20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .bottom-nav .nav-item.special .nav-icon {
    font-size: 1.8rem;
  }
</style>
