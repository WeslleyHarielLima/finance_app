<div class="home-container">
  <header class="home-header">
    <h1 class="logo">💰 Finanças Pro</h1>
    <p class="tagline">Controle financeiro inteligente</p>
  </header>

  <main class="home-main">
    <% if user_signed_in? %>
      <div class="welcome-card">
        <h2>Bem-vindo, <%= current_user.name %>!</h2>
        <p class="balance">Saldo atual: <strong>R$ 0,00</strong></p>
        
        <div class="quick-actions">
          <%= link_to "📊 Dashboard", "#", class: "btn btn-primary" %>
          <%= link_to "💰 Nova Transação", "#", class: "btn btn-success" %>
          <%= link_to "⚙️ Configurações", "#", class: "btn btn-secondary" %>
          <%= link_to "🚪 Sair", destroy_user_session_path, 
              data: { turbo_method: :delete }, class: "btn btn-outline" %>
        </div>
      </div>
    <% else %>
      <div class="auth-card">
        <h2>Comece a controlar suas finanças</h2>
        <p class="description">
          Cadastre-se gratuitamente e tenha controle total dos seus gastos,
          receitas e investimentos.
        </p>
        
        <div class="auth-actions">
          <%= link_to "📝 Cadastrar", new_user_registration_path, class: "btn btn-success btn-lg" %>
          <%= link_to "🔑 Entrar", new_user_session_path, class: "btn btn-primary btn-lg" %>
        </div>
        
        <div class="features">
          <div class="feature">
            <span class="icon">💸</span>
            <h3>Controle de Gastos</h3>
            <p>Monitore cada centavo gasto</p>
          </div>
          <div class="feature">
            <span class="icon">📈</span>
            <h3>Orçamento Inteligente</h3>
            <p>Planeje e cumpra metas</p>
          </div>
          <div class="feature">
            <span class="icon">🔔</span>
            <h3>Alertas Personalizados</h3>
            <p>Receba notificações importantes</p>
          </div>
        </div>
      </div>
    <% end %>
  </main>
</div>

<style>
  .home-container {
    min-height: 100vh;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 20px;
  }
  
  .home-header {
    text-align: center;
    color: white;
    margin-bottom: 40px;
  }
  
  .logo {
    font-size: 2.5rem;
    margin-bottom: 10px;
  }
  
  .tagline {
    font-size: 1.2rem;
    opacity: 0.9;
  }
  
  .home-main {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .welcome-card, .auth-card {
    background: white;
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.1);
  }
  
  .btn {
    display: inline-block;
    padding: 12px 24px;
    margin: 8px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s;
  }
  
  .btn-primary { background: #4a6fa5; color: white; }
  .btn-success { background: #28a745; color: white; }
  .btn-secondary { background: #6c757d; color: white; }
  .btn-outline { border: 2px solid #4a6fa5; color: #4a6fa5; }
  
  .btn-lg { padding: 15px 30px; font-size: 1.1rem; }
  
  .features {
    display: flex;
    justify-content: space-between;
    margin-top: 40px;
    flex-wrap: wrap;
  }
  
  .feature {
    flex: 1;
    min-width: 200px;
    text-align: center;
    padding: 20px;
  }
  
  .feature .icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 10px;
  }
  
  @media (max-width: 768px) {
    .features { flex-direction: column; }
    .btn { display: block; margin: 10px 0; }
  }
</style>
