<div class="auth-container">
  <h2>Criar Conta</h2>

  <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'auth-form' }) do |f| %>
    <%= f.error_notification message: "Verifique os erros abaixo:" %>

    <div class="form-inputs">
      <%= f.input :name,
                  label: "Nome",
                  required: true,
                  autofocus: true,
                  placeholder: "Seu nome completo",
                  input_html: { autocomplete: "name" } %>
      <%= f.input :email,
                  label: "E-mail",
                  required: true,
                  placeholder: "seu@email.com",
                  input_html: { autocomplete: "email" } %>
      <%= f.input :password,
                  label: "Senha",
                  required: true,
                  hint: ("Minimo de #{@minimum_password_length} caracteres" if @minimum_password_length),
                  input_html: { autocomplete: "new-password" } %>
      <%= f.input :password_confirmation,
                  label: "Confirmar Senha",
                  required: true,
                  input_html: { autocomplete: "new-password" } %>
    </div>

    <div class="form-actions">
      <%= f.button :submit, "Cadastrar", class: "btn btn-primary" %>
    </div>
  <% end %>

  <div class="auth-links">
    <p>Ja tem uma conta? <%= link_to "Entrar", new_user_session_path %></p>
  </div>
</div>
