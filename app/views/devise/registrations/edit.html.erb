<div class="auth-container">
  <h2>Editar Conta</h2>

  <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: 'auth-form' }) do |f| %>
    <%= f.error_notification message: "Verifique os erros abaixo:" %>

    <div class="form-inputs">
      <%= f.input :name,
                  label: "Nome",
                  required: true,
                  autofocus: true,
                  input_html: { autocomplete: "name" } %>
      <%= f.input :email,
                  label: "E-mail",
                  required: true,
                  input_html: { autocomplete: "email" } %>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="pending-confirmation">Aguardando confirmacao para: <%= resource.unconfirmed_email %></p>
      <% end %>

      <%= f.input :password,
                  label: "Nova Senha",
                  hint: "Deixe em branco se nao quiser alterar",
                  required: false,
                  input_html: { autocomplete: "new-password" } %>
      <%= f.input :password_confirmation,
                  label: "Confirmar Nova Senha",
                  required: false,
                  input_html: { autocomplete: "new-password" } %>
      <%= f.input :current_password,
                  label: "Senha Atual",
                  hint: "Precisamos da sua senha atual para confirmar as alteracoes",
                  required: true,
                  input_html: { autocomplete: "current-password" } %>
    </div>

    <div class="form-actions">
      <%= f.button :submit, "Atualizar", class: "btn btn-primary" %>
    </div>
  <% end %>

  <div class="danger-zone">
    <h3>Excluir Conta</h3>
    <p>Esta acao e irreversivel. Todos os seus dados serao perdidos.</p>
    <%= button_to "Excluir minha conta", registration_path(resource_name),
        method: :delete,
        data: { turbo_confirm: "Tem certeza? Esta acao nao pode ser desfeita." },
        class: "btn btn-danger" %>
  </div>

  <div class="auth-links">
    <%= link_to "Voltar", :back %>
  </div>
</div>

<style>
  .auth-container {
    max-width: 400px;
    margin: 40px auto;
    padding: 20px;
  }

  .auth-container h2 {
    text-align: center;
    margin-bottom: 24px;
    color: #333;
  }

  .auth-form .form-inputs {
    margin-bottom: 20px;
  }

  .auth-form .input {
    margin-bottom: 16px;
  }

  .auth-form label {
    display: block;
    margin-bottom: 5px;
    font-weight: 600;
    color: #333;
  }

  .auth-form input[type="text"],
  .auth-form input[type="email"],
  .auth-form input[type="password"] {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 16px;
  }

  .auth-form .hint {
    font-size: 0.8rem;
    color: #666;
    margin-top: 4px;
  }

  .btn {
    width: 100%;
    padding: 12px;
    background: #4a6fa5;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
  }

  .btn-danger {
    background: #dc3545;
  }

  .pending-confirmation {
    padding: 8px 12px;
    background: #fff3cd;
    color: #856404;
    border-radius: 8px;
    font-size: 0.9rem;
  }

  .danger-zone {
    margin-top: 32px;
    padding: 20px;
    border: 1px solid #f5c6cb;
    border-radius: 12px;
    background: #fff5f5;
  }

  .danger-zone h3 {
    margin: 0 0 8px 0;
    color: #dc3545;
    font-size: 1rem;
  }

  .danger-zone p {
    margin: 0 0 16px 0;
    color: #666;
    font-size: 0.9rem;
  }

  .auth-links {
    margin-top: 20px;
    text-align: center;
  }

  .auth-links a {
    color: #4a6fa5;
  }
</style>
