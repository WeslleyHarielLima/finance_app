<div class="auth-container">
  <h2>Esqueceu sua senha?</h2>
  <p class="auth-description">Informe seu e-mail e enviaremos instrucoes para redefinir sua senha.</p>

  <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: 'auth-form' }) do |f| %>
    <%= f.error_notification message: "Verifique os erros abaixo:" %>

    <div class="form-inputs">
      <%= f.input :email,
                  label: "E-mail",
                  required: true,
                  autofocus: true,
                  placeholder: "seu@email.com",
                  input_html: { autocomplete: "email" } %>
    </div>

    <div class="form-actions">
      <%= f.button :submit, "Enviar instrucoes", class: "btn btn-primary" %>
    </div>
  <% end %>

  <div class="auth-links">
    <p><%= link_to "Voltar para login", new_user_session_path %></p>
  </div>
</div>
