<div class="mobile-container">
  <header class="page-header">
    <h1>Editar Orcamento</h1>
    <%= link_to "Voltar", monthly_budgets_path, class: "btn-back" %>
  </header>

  <div class="form-container mobile-card">
    <%= render "form", budget: @budget %>
  </div>
</div>

<%= render "shared/bottom_nav" %>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 16px;
    background: white;
    border-bottom: 1px solid #e0e0e0;
  }

  .page-header h1 {
    margin: 0;
    font-size: 1.5rem;
  }

  .btn-back {
    color: #4a6fa5;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .form-container {
    margin: 16px;
    padding: 20px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: 600;
    color: #333;
  }

  .form-control {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 16px;
  }

  .form-actions {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }

  .form-actions .btn {
    flex: 1;
    text-align: center;
    padding: 12px;
    border-radius: 8px;
    font-size: 16px;
    text-decoration: none;
    border: none;
    cursor: pointer;
  }

  .btn-primary {
    background: #4a6fa5;
    color: white;
  }

  .btn-outline {
    border: 2px solid #4a6fa5;
    color: #4a6fa5;
    background: white;
  }

  .error-messages {
    background: #f8d7da;
    color: #721c24;
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 20px;
  }

  .error-messages h4 { margin: 0 0 8px 0; }
  .error-messages ul { margin: 0; padding-left: 20px; }
</style>
