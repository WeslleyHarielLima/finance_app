<div class="mobile-container">
  <header class="page-header">
    <h1>Orcamento Mensal</h1>
    <%= link_to "Novo Orcamento", new_monthly_budget_path, class: "btn btn-primary btn-sm" %>
  </header>

  <% if @current_budget %>
    <div class="current-budget mobile-card">
      <h3>Mes Atual - <%= l(@current_budget.month, format: "%B %Y") rescue @current_budget.month.strftime("%B %Y") %></h3>

      <div class="budget-progress">
        <div class="progress-bar">
          <div class="progress-fill <%= 'exceeded' if @current_budget.exceeded? %>"
               style="width: <%= [@current_budget.percentage_used, 100].min %>%">
          </div>
        </div>
        <div class="progress-info">
          <span class="spent">Gasto: R$ <%= number_with_precision(@current_budget.spent, precision: 2) %></span>
          <span class="total">de R$ <%= number_with_precision(@current_budget.total_amount, precision: 2) %></span>
        </div>
      </div>

      <div class="budget-stats">
        <div class="stat">
          <span class="stat-label">Usado</span>
          <span class="stat-value"><%= @current_budget.percentage_used %>%</span>
        </div>
        <div class="stat">
          <span class="stat-label">Restante</span>
          <span class="stat-value <%= @current_budget.remaining < 0 ? 'negative' : 'positive' %>">
            R$ <%= number_with_precision(@current_budget.remaining, precision: 2) %>
          </span>
        </div>
      </div>

      <% if @current_budget.exceeded? %>
        <div class="budget-alert">
          Orcamento excedido em R$ <%= number_with_precision(@current_budget.remaining.abs, precision: 2) %>!
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="no-budget mobile-card">
      <p>Nenhum orcamento definido para o mes atual.</p>
      <%= link_to "Definir orcamento", new_monthly_budget_path, class: "btn btn-primary" %>
    </div>
  <% end %>

  <% if @budgets.any? %>
    <div class="budgets-history mobile-card">
      <h3>Historico</h3>
      <% @budgets.each do |budget| %>
        <div class="budget-item">
          <div class="budget-info">
            <h4><%= budget.month.strftime("%B %Y") %></h4>
            <p class="budget-meta">
              R$ <%= number_with_precision(budget.spent, precision: 2) %> /
              R$ <%= number_with_precision(budget.total_amount, precision: 2) %>
            </p>
          </div>
          <div class="budget-item-actions">
            <span class="badge <%= budget.exceeded? ? 'badge-danger' : 'badge-success' %>">
              <%= budget.percentage_used %>%
            </span>
            <%= link_to "Editar", edit_monthly_budget_path(budget), class: "btn-action" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<%= render "shared/bottom_nav" %>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 16px;
    background: white;
    border-bottom: 1px solid #e0e0e0;
  }

  .page-header h1 {
    margin: 0;
    font-size: 1.5rem;
  }

  .btn-sm {
    padding: 8px 16px;
    font-size: 0.9rem;
  }

  .current-budget, .no-budget, .budgets-history {
    margin: 16px;
    padding: 20px;
  }

  .current-budget h3, .budgets-history h3 {
    margin: 0 0 16px 0;
    font-size: 1.1rem;
  }

  .progress-bar {
    width: 100%;
    height: 20px;
    background: #e9ecef;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 8px;
  }

  .progress-fill {
    height: 100%;
    background: #28a745;
    border-radius: 10px;
    transition: width 0.5s ease;
  }

  .progress-fill.exceeded {
    background: #dc3545;
  }

  .progress-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: #666;
  }

  .budget-stats {
    display: flex;
    justify-content: space-around;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid #eee;
  }

  .stat {
    text-align: center;
  }

  .stat-label {
    display: block;
    font-size: 0.8rem;
    color: #666;
    margin-bottom: 4px;
  }

  .stat-value {
    font-size: 1.2rem;
    font-weight: bold;
  }

  .stat-value.positive { color: #28a745; }
  .stat-value.negative { color: #dc3545; }

  .budget-alert {
    margin-top: 16px;
    padding: 12px;
    background: #f8d7da;
    color: #721c24;
    border-radius: 8px;
    text-align: center;
    font-weight: 600;
  }

  .no-budget {
    text-align: center;
  }

  .no-budget p {
    color: #666;
    margin-bottom: 16px;
  }

  .budget-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid #eee;
  }

  .budget-item:last-child {
    border-bottom: none;
  }

  .budget-info h4 {
    margin: 0 0 4px 0;
    font-size: 1rem;
    text-transform: capitalize;
  }

  .budget-meta {
    margin: 0;
    font-size: 0.8rem;
    color: #666;
  }

  .budget-item-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .badge {
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .badge-success {
    background: #d4edda;
    color: #155724;
  }

  .badge-danger {
    background: #f8d7da;
    color: #721c24;
  }

  .btn-action {
    padding: 6px 12px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.85rem;
    color: #4a6fa5;
    background: #e8f0fe;
  }

  .btn-primary {
    display: inline-block;
    padding: 12px 24px;
    background: #4a6fa5;
    color: white;
    border: none;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
  }
</style>
