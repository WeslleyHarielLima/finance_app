<div class="mobile-container">
  <header class="page-header">
    <h1>Orcamento Mensal</h1>
    <%= link_to "Novo Orcamento", new_monthly_budget_path, class: "btn btn-primary btn-sm" %>
  </header>

  <% if @current_budget %>
    <div class="current-budget mobile-card">
      <h3>Mes Atual - <%= l(@current_budget.month, format: "%B %Y") rescue @current_budget.month.strftime("%B %Y") %></h3>

      <div class="budget-progress">
        <div class="progress-bar">
          <div class="progress-fill <%= 'exceeded' if @current_budget.exceeded? %>"
               style="width: <%= [@current_budget.percentage_used, 100].min %>%">
          </div>
        </div>
        <div class="progress-info">
          <span class="spent">Gasto: R$ <%= number_with_precision(@current_budget.spent, precision: 2) %></span>
          <span class="total">de R$ <%= number_with_precision(@current_budget.total_amount, precision: 2) %></span>
        </div>
      </div>

      <div class="budget-stats">
        <div class="stat">
          <span class="stat-label">Usado</span>
          <span class="stat-value"><%= @current_budget.percentage_used %>%</span>
        </div>
        <div class="stat">
          <span class="stat-label">Restante</span>
          <span class="stat-value <%= @current_budget.remaining < 0 ? 'negative' : 'positive' %>">
            R$ <%= number_with_precision(@current_budget.remaining, precision: 2) %>
          </span>
        </div>
      </div>

      <% if @current_budget.exceeded? %>
        <div class="budget-alert">
          Orcamento excedido em R$ <%= number_with_precision(@current_budget.remaining.abs, precision: 2) %>!
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="no-budget mobile-card">
      <p>Nenhum orcamento definido para o mes atual.</p>
      <%= link_to "Definir orcamento", new_monthly_budget_path, class: "btn btn-primary" %>
    </div>
  <% end %>

  <% if @budgets.any? %>
    <div class="budgets-history mobile-card">
      <h3>Historico</h3>
      <% @budgets.each do |budget| %>
        <div class="budget-item">
          <div class="budget-info">
            <h4><%= budget.month.strftime("%B %Y") %></h4>
            <p class="budget-meta">
              R$ <%= number_with_precision(budget.spent, precision: 2) %> /
              R$ <%= number_with_precision(budget.total_amount, precision: 2) %>
            </p>
          </div>
          <div class="budget-item-actions">
            <span class="badge <%= budget.exceeded? ? 'badge-danger' : 'badge-success' %>">
              <%= budget.percentage_used %>%
            </span>
            <%= link_to "Editar", edit_monthly_budget_path(budget), class: "btn-action" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
