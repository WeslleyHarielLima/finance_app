<div class="mobile-container">
  <div class="page-header">
    <h1>Transacoes</h1>
    <div class="header-actions">
      <%= link_to new_financial_entry_path(entry_type: 'income'), class: "btn btn-sm success" do %>
        + Receita
      <% end %>
      <%= link_to new_financial_entry_path(entry_type: 'expense'), class: "btn btn-sm danger" do %>
        - Despesa
      <% end %>
    </div>
  </div>

  <div class="search-section mobile-card">
    <%= form_tag financial_entries_path, method: :get, class: "search-form" do %>
      <div class="search-input-group">
        <%= text_field_tag :search, params[:search],
            placeholder: "Buscar transacao...",
            class: "form-control search-input",
            aria: { label: "Buscar transacoes" } %>
        <%= submit_tag "Buscar", class: "btn btn-sm btn-primary" %>
      </div>
    <% end %>
  </div>

  <div class="filters mobile-card">
    <h3>Filtros</h3>
    <div class="filter-options">
      <%= link_to "Todas", financial_entries_path,
          class: "filter-tag #{'active' unless params[:entry_type].present?}" %>
      <%= link_to "Receitas", financial_entries_path(entry_type: 'income'),
          class: "filter-tag #{'active' if params[:entry_type] == 'income'}" %>
      <%= link_to "Despesas", financial_entries_path(entry_type: 'expense'),
          class: "filter-tag #{'active' if params[:entry_type] == 'expense'}" %>
    </div>

    <% if @categories && @categories.any? %>
      <div class="category-filters">
        <select class="category-select" onchange="if(this.value) window.location.href = this.value" aria-label="Filtrar por categoria">
          <option value="<%= financial_entries_path %>">Todas categorias</option>
          <% @categories.each do |category| %>
            <option value="<%= financial_entries_path(category_id: category.id) %>"
                    <%= 'selected' if params[:category_id] == category.id.to_s %>>
              <%= category.icon %> <%= category.name %>
            </option>
          <% end %>
        </select>
      </div>
    <% end %>
  </div>

  <div class="export-actions mobile-card">
    <%= link_to "Exportar CSV", financial_entries_path(format: :csv, **request.query_parameters),
        class: "btn btn-outline btn-sm", aria: { label: "Exportar transacoes em CSV" } %>
    <%= link_to "Exportar PDF", financial_entries_path(format: :pdf, **request.query_parameters),
        class: "btn btn-outline btn-sm", aria: { label: "Exportar transacoes em PDF" } %>
  </div>

  <% if @financial_entries && @financial_entries.any? %>
    <div class="transactions-list">
      <% @financial_entries.each do |transaction| %>
        <div class="transaction-item mobile-card">
          <div class="transaction-main">
            <div class="transaction-icon <%= transaction.entry_type %>" aria-hidden="true">
              <%= transaction.category&.icon || (transaction.entry_type == 'income' ? '💰' : '💸') %>
            </div>
            <div class="transaction-details">
              <h4><%= transaction.description %></h4>
              <div class="transaction-meta">
                <span class="date"><%= transaction.date.strftime("%d/%m/%Y") %></span>
                <span class="category"><%= transaction.category&.name || "Sem categoria" %></span>
                <% if transaction.recurring? %>
                  <span class="recurring-badge">Recorrente</span>
                <% end %>
              </div>
            </div>
          </div>

          <div class="transaction-actions">
            <div class="transaction-amount <%= transaction.entry_type %>">
              <%= transaction.entry_type == 'income' ? '+' : '-' %>
              R$ <%= number_with_precision(transaction.amount, precision: 2) %>
            </div>
            <div class="action-buttons">
              <%= link_to edit_financial_entry_path(transaction), class: "btn-icon",
                  aria: { label: "Editar #{transaction.description}" } do %>
                ✏️
              <% end %>
              <%= link_to transaction,
                  data: { turbo_method: :delete, turbo_confirm: 'Tem certeza?' },
                  class: "btn-icon danger",
                  aria: { label: "Excluir #{transaction.description}" } do %>
                🗑️
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="pagination-container">
      <%= paginate @financial_entries %>
    </div>
  <% else %>
    <div class="empty-state mobile-card">
      <div class="empty-icon" aria-hidden="true">📭</div>
      <h3>Nenhuma transacao encontrada</h3>
      <p>Comece adicionando sua primeira transacao financeira.</p>
      <div class="empty-actions">
        <%= link_to "Nova Receita", new_financial_entry_path(entry_type: 'income'), class: "btn btn-success" %>
        <%= link_to "Nova Despesa", new_financial_entry_path(entry_type: 'expense'), class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>
